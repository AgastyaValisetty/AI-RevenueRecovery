# People Service Environment Variables
# Copy to .env and fill in values before running.

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=simulator
DB_PASSWORD=simulator_dev
DB_NAME=revenue_recovery

# --- Services ---
LAZERPAY_URL=http://lazerpay_service:8001
BANK_URL=http://bank_service:8002
HTTP_TIMEOUT_SECONDS=30.0

# --- NVIDIA Nemotron LLM (Smart Agent) ---
# DO NOT commit this key to a public repository!
# The repo is public; this file is safe to commit (no key).
# Set the actual key in your local .env file.
NVIDIA_NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL_NAME=nvidia/nemotron-3.5b-30b-a3b
NIM_TEMPERATURE=0.2
NIM_TOP_P=0.95
NIM_MAX_TOKENS=2048
# Modes: "live" (call NIM API), "replay" (reuse stored outputs), "fallback" (deterministic)
NIM_MODE=fallback
NIM_PROMPT_VERSION=1.0.0
